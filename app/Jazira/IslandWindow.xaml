<Window x:Class="Jazira.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jazira" Width="480" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="#F2F7F6">
  <Window.Resources>
    <SolidColorBrush x:Key="Dim" Color="#A6F2F7F6"/>
    <SolidColorBrush x:Key="Faint" Color="#6BF2F7F6"/>
    <SolidColorBrush x:Key="Lagoon" Color="#2FD4B8"/>
    <SolidColorBrush x:Key="Coral" Color="#FF7A59"/>
    <SolidColorBrush x:Key="Sky" Color="#5CC8FF"/>
    <SolidColorBrush x:Key="Green" Color="#2FCF73"/>
    <SolidColorBrush x:Key="Muted" Color="#3A4A50"/>
    <LinearGradientBrush x:Key="CoverGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2FD4B8" Offset="0"/>
      <GradientStop Color="#1B6F8A" Offset="0.5"/>
      <GradientStop Color="#FFB15C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SunGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFE0A3" Offset="0"/>
      <GradientStop Color="#FF8A4C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WaterGradient" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#1F8FE0" Offset="0"/>
      <GradientStop Color="#5CC8FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Круглая кнопка с иконкой -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="99">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Кнопка-таблетка с текстом -->
    <Style x:Key="PillBtn" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Foreground" Value="#F2F7F6"/>
      <Setter Property="Background" Value="#1FFFFFFF"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- Радиус ровно в половину высоты (30): больший WPF превращает таблетку в овал -->
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Окно прозрачное: сквозь пустые места клики проходят к окнам под ним -->
  <Grid x:Name="Root">
    <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
            Width="196" Height="34" CornerRadius="17" Background="#020507"
            BorderBrush="#1CFFFFFF" BorderThickness="1"
            MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
            MouseWheel="Island_MouseWheel" SizeChanged="Island_SizeChanged">
      <Border.Effect>
        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black"/>
      </Border.Effect>

      <Grid x:Name="Body">

        <!-- ===== Покой: время, слева солнце или эквалайзер, справа заряд или таймер ===== -->
        <Grid x:Name="IdlePanel" Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="IdleSun" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource SunGradient}"/>
          <StackPanel x:Name="IdleEq" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
            <Rectangle x:Name="Eq1" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Lagoon}" VerticalAlignment="Center" Margin="0,0,2,0"/>
            <Rectangle x:Name="Eq2" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Lagoon}" VerticalAlignment="Center" Margin="0,0,2,0"/>
            <Rectangle x:Name="Eq3" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Lagoon}" VerticalAlignment="Center" Margin="0,0,2,0"/>
            <Rectangle x:Name="Eq4" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Lagoon}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="IdleTime" Grid.Column="1" Text="18:55" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Path x:Name="IdleBolt" Width="7" Height="11" Stretch="Uniform" Fill="{StaticResource Green}" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="IdleRight" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- ===== Музыка ===== -->
        <Grid x:Name="MusicPanel" Margin="34,14,34,8" Visibility="Collapsed" Opacity="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CoverBox" Width="56" Height="56" CornerRadius="12" Background="{StaticResource CoverGradient}">
              <Path x:Name="CoverNote" Width="22" Height="22" Stretch="Uniform" Fill="#F2FFFFFF"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="MusicTitle" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="MusicArtist" FontSize="12.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              <TextBlock x:Name="MusicApp" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="ProgressRow" Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="38"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="38"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PosText" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
            <Grid x:Name="ProgTrack" Grid.Column="1" Height="4" Margin="6,0" VerticalAlignment="Center">
              <Border CornerRadius="2" Background="#26FFFFFF"/>
              <Border x:Name="ProgFill" CornerRadius="2" Background="#F2F7F6" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <TextBlock x:Name="DurText" Grid.Column="2" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel x:Name="MusicControls" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource IconBtn}" Click="Prev_Click">
              <Path x:Name="PrevIcon" Width="14" Height="14" Stretch="Uniform" Fill="#F2F7F6"/>
            </Button>
            <Button Style="{StaticResource IconBtn}" Width="38" Height="38" Margin="16,0" Click="PlayPause_Click">
              <Path x:Name="PlayIcon" Width="16" Height="16" Stretch="Uniform" Fill="#F2F7F6"/>
            </Button>
            <Button Style="{StaticResource IconBtn}" Click="Next_Click">
              <Path x:Name="NextIcon" Width="14" Height="14" Stretch="Uniform" Fill="#F2F7F6"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- ===== Фокус ===== -->
        <Grid x:Name="FocusPanel" Margin="36,0" Visibility="Collapsed" Opacity="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="FocusRing" Width="64" Height="64" VerticalAlignment="Center">
            <Ellipse x:Name="FocusTrack" Stroke="#38FF7A59" StrokeThickness="6"/>
            <Ellipse x:Name="FocusArc" Stroke="{StaticResource Coral}" StrokeThickness="6" StrokeDashCap="Round"
                     StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <RotateTransform Angle="-90"/>
              </Ellipse.RenderTransform>
            </Ellipse>
            <Path x:Name="FocusIcon" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource Coral}"/>
          </Grid>
          <StackPanel Grid.Column="1" Margin="16,0,8,0" VerticalAlignment="Center">
            <TextBlock x:Name="FocusLabel" FontSize="12.5" Foreground="{StaticResource Dim}"/>
            <TextBlock x:Name="FocusTime" FontSize="32" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Button x:Name="FocusStartBtn" Style="{StaticResource PillBtn}" Background="{StaticResource Coral}" Foreground="#1C1006" MinWidth="118" Click="FocusStart_Click">
              <TextBlock x:Name="FocusStartText"/>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
              <Button Style="{StaticResource PillBtn}" Padding="12,0" Click="FocusMode_Click">
                <TextBlock x:Name="FocusModeText"/>
              </Button>
              <Button Style="{StaticResource IconBtn}" Width="30" Height="30" Margin="6,0,0,0" Background="#1FFFFFFF" Click="FocusReset_Click">
                <Path x:Name="ResetIcon" Width="13" Height="13" Stretch="Uniform" Stroke="#F2F7F6" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- ===== Вода ===== -->
        <Grid x:Name="WaterPanel" Margin="36,0" Visibility="Collapsed" Opacity="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Path x:Name="WaterDrop" Width="32" Height="40" Stretch="Uniform" Fill="{StaticResource Sky}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="16,0,14,0" VerticalAlignment="Center">
            <TextBlock>
              <Run x:Name="WaterNow" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/><Run x:Name="WaterGoalRun" FontSize="13" Foreground="{StaticResource Dim}"/>
            </TextBlock>
            <Grid x:Name="WaterTrack" Height="6" Margin="0,7,0,0">
              <Border CornerRadius="3" Background="#26FFFFFF"/>
              <Border x:Name="WaterFill" CornerRadius="3" Background="{StaticResource WaterGradient}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <TextBlock x:Name="WaterNote" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Button Style="{StaticResource PillBtn}" Background="#1F7FD8" MinWidth="96" Click="Water250_Click">
              <TextBlock x:Name="Water250Text"/>
            </Button>
            <Button Style="{StaticResource PillBtn}" MinWidth="96" Margin="0,8,0,0" Click="WaterUndo_Click">
              <TextBlock x:Name="WaterUndoText"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- ===== Короткое уведомление («пик») ===== -->
        <Grid x:Name="PeekPanel" Margin="8,0,14,0" Visibility="Collapsed" Opacity="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="PeekIconBox" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center">
            <Path x:Name="PeekIcon" Width="13" Height="15" Stretch="Uniform" Fill="#FFFFFF"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="PeekTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PeekSub" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PeekRight" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="PeekAction" Style="{StaticResource PillBtn}" Background="#1F7FD8" Visibility="Collapsed" Click="PeekAction_Click">
              <TextBlock x:Name="PeekActionText"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- ===== Стрелки между страницами (видны в раскрытом острове) ===== -->
        <Grid x:Name="NavLayer" Visibility="Collapsed">
          <Button Style="{StaticResource IconBtn}" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Click="NavLeft_Click">
            <Path x:Name="NavLeftIcon" Width="8" Height="12" Stretch="Uniform" Stroke="#A6F2F7F6" StrokeThickness="2.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Button>
          <Button Style="{StaticResource IconBtn}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Click="NavRight_Click">
            <Path x:Name="NavRightIcon" Width="8" Height="12" Stretch="Uniform" Stroke="#A6F2F7F6" StrokeThickness="2.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
